  "module_documentation": {
    "backend": {
      "main_modules": [
        {
          "name": "auth",
          "description": "Authentication and authorization system",
          "readme": "backend/auth/README.md",
          "components": ["models", "routes", "utils"]
        },
        {
          "name": "db",
          "description": "Database models, connections, and initialization",
          "readme": "backend/db/README.md",
          "components": ["models", "session", "init_data"]
        },
        {
          "name": "data_providers",
          "description": "Pluggable data provider system",
          "readme": "backend/data_providers/README.md",
          "components": ["base_provider", "kaggle_provider", "provider_factory"]
        },
        {
          "name": "routes",
          "description": "FastAPI route handlers",
          "readme": "backend/routes/README.md",
          "components": ["valuation", "transform", "providers", "companies"]
        },
        {
          "name": "services",
          "description": "Business logic and data processing services",
          "readme": "backend/services/README.md",
          "components": ["transform_engine", "formula_evaluator", "financial_data_service"]
        },
        {
          "name": "schemas",
          "description": "Pydantic data validation schemas",
          "readme": "backend/schemas/README.md",
          "components": ["valuation", "provider", "mapping"]
        }
      ]
    },
    "frontend": {
      "main_modules": [
        {
          "name": "components",
          "description": "Reusable React components",
          "readme": "frontend/src/components/README.md",
          "components": ["Layout", "ProtectedRoute", "ThemeToggle", "PriceChart"]
        },
        {
          "name": "pages",
          "description": "Main application pages and views",
          "readme": "frontend/src/pages/README.md",
          "components": ["Dashboard", "Companies", "Valuations", "Providers", "Login"]
        },
        {
          "name": "services",
          "description": "API client services",
          "readme": "frontend/src/services/README.md",
          "components": ["auth", "companies", "providers"]
        },
        {
          "name": "contexts",
          "description": "React context providers",
          "readme": "frontend/src/contexts/README.md",
          "components": ["AuthContext", "ThemeContext"]
        }
      ]
    }
  },
  "inline_documentation": {
    "docstring_targets": [
      "backend/data_providers/base_provider.py",
      "backend/services/transform_engine.py", 
      "backend/services/formula_evaluator.py",
      "backend/db/models/*.py",
      "backend/routes/*.py"
    ],
    "comment_targets": [
      "Complex business logic in services",
      "Database initialization scripts",
      "Frontend component logic",
      "Configuration files"
    ]
  }
}